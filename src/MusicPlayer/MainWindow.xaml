<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Player">

        <Grid Background="#000000">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="sidebar" MinWidth="180" MaxWidth="420" />
                        <ColumnDefinition Width = "8" />
                        <ColumnDefinition Width = "*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column = "0" Background = "#FFFFFF" Padding = "16">
                        <StackPanel>
                                <!--sidebar content-->
                        </StackPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                        Width="8"
                        Background="Transparent"
                        Cursor="SizeWE"
                        ResizeDirection="Columns"
                        ResizeBehavior="PreviousAndNext">

                        <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333333"/>
                                        </Trigger>
                                </Style.Triggers>
                                </Style>
                        </GridSplitter.Style>
                </GridSplitter>

                <Grid Grid.Column = "2" Background = "#000000">
                        <ScrollViewer VerticalScrollBarVisibility = "Auto" HorizontalScrollBarVisibility = "Disabled">
                                <StackPanel Margin = "20">
                                        <TextBlock Text = "Music"
                                                FontSize = "28"
                                                FontWeight = "Bold"
                                                Foreground = "Black"
                                                Margin = "0,0,0,20"/>
                                        <ItemsControl ItemsSource = "{Binding Albums}">

                                                <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                                <WrapPanel Orientation = "Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                <StackPanel Width = "160"
                                                                        Margin = "0,0,20,24">
                                                                        <Border Width = "160"
                                                                                Height = "160"
                                                                                Background = "Black"
                                                                                ClipToBounds = "True">
                                                                                <Image Source = "{Binding artworkPath}"
                                                                                        Stretch = "Uniform"
                                                                                        RenderOptions.BitmapScalingMode = "HighQuality"
                                                                                        SnapsToDevicePixels = "True"/>
                                                                        </Border>

                                                                        <TextBlock Text = "{Binding title}"
                                                                                Foreground = "White"
                                                                                FontSize = "14"
                                                                                FontWeight = "Bold"
                                                                                Margin = "0,8,0,2"
                                                                                TextTrimming = "CharacterEllipsis"/>

                                                                        <TextBlock Text = "{Binding albumArtist}"
                                                                                Foreground = "White"
                                                                                FontSize = "12"
                                                                                TextTrimming = "CharacterEllipsis"/>

                                                                        <TextBlock Text = "{Binding genre}"
                                                                                Foreground = "White"
                                                                                FontSize = "12"
                                                                                TextTrimming = "CharacterEllipsis"/>
                                                                </StackPanel>
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>
                        </ScrollViewer>
                </Grid>
        </Grid>
</Window>
